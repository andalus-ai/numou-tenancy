<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.kayys.numou</groupId>
        <artifactId>numou-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>tech.kayys.numou</groupId>
    <artifactId>numou-tenancy-bom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Numou Tenancy BOM</name>
    <description>Version alignment for artifacts owned by the Numou Tenancy repository.</description>

    <properties>
        <numou.platform.version>0.1.0-SNAPSHOT</numou.platform.version>
    </properties>

    <repositories>
        <repository>
            <id>github</id>
            <name>Numou shared platform packages</name>
            <url>https://maven.pkg.github.com/andalus-ai/numu</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-bom</artifactId>
                <version>${numou.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-tenancy-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-tenancy-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-tenancy-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-tenancy-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>Numou Tenancy GitHub Packages</name>
            <url>https://maven.pkg.github.com/andalus-ai/numou-tenancy</url>
        </repository>
    </distributionManagement>
</project>
